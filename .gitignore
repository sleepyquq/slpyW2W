/data/
/profiles/
/generated/
/backups/
/logs/
/migrations/
/runtime/
*.conf
*.key
*.migration.zip

# 本地工具与内核二进制
/tools/
*.exe
*.dll

# 编辑器与系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db

