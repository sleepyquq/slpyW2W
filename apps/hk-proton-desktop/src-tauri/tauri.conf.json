{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "slpyW2W",
  "version": "0.1.0",
  "identifier": "app.hkproton.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "slpyW2W",
        "width": 560,
        "height": 520,
        "minWidth": 560,
        "minHeight": 520,
        "maxWidth": 560,
        "maxHeight": 520,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:1420",
        "connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:1420",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": false
  }
}
